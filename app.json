{
  "expo": {
    "name": "Hive",
    "slug": "hive-official",
    "description": "Collaborative apartment hunting for college students near campus.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/hivelogoappicon.png",
    "scheme": "hiveofficial",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.skill4ace.hiveofficial",
      "buildNumber": "1",
      "supportsTablet": false,
      "icon": "./assets/images/hivelogoappicon.png",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "localhost": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.skill4ace.hiveofficial",
      "versionCode": 1,
      "icon": "./assets/images/hivelogoappicon.png",
      "adaptiveIcon": {
        "backgroundColor": "#3B1C44",
        "foregroundImage": "./assets/images/hivelogoappicon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/hivelogoappicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3B1C44",
          "image": "./assets/images/HiveSplashScreen.png",
          "imageWidth": 288,
          "resizeMode": "cover",
          "ios": {
            "enableFullScreenImage_legacy": true
          }
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
